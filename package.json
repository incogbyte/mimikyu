{
  "name": "mimikyu",
  "version": "0.1.0",
  "private": true,
  "author": {
    "name": "Incogbyte",
    "url": "https://github.com/incogbyte"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:incogbyte/mimikyu.git"
  },
  "packageManager": "pnpm@11.23.0",
  "browserslist": ["Chrome >= 120", "Firefox >= 120"],
  "scripts": {
    "test": "pnpm -r typecheck && pnpm lint",
    "test:backend": "pnpm --filter backend typecheck",
    "test:agent": "node --check agent/server.mjs && node --check agent/browser-manager.mjs && node --check agent/browser-executor.mjs && node --check agent/fetch-generator.mjs && node --check agent/request-classifier.mjs && node --check agent/relay.mjs && node --check agent/hook-runner.mjs && npm test --prefix agent",
    "test:e2e:agent": "node tests/e2e/agent-smoke.mjs",
    "test:e2e:websocket": "node tests/e2e/agent-websocket-smoke.mjs",
    "test:e2e:caido": "node tests/e2e/caido-smoke.mjs",
    "test:e2e:origin": "node tests/e2e/protocol-origin-smoke.mjs",
    "watch": "caido-dev watch",
    "build": "caido-dev build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint ./packages/**/src --max-warnings 0",
    "lint:fix": "eslint ./packages/**/src --fix --max-warnings 0",
    "knip": "knip"
  },
  "devDependencies": {
    "@caido-community/dev": "0.1.7",
    "@caido/eslint-config": "0.10.0",
    "@caido/tailwindcss": "0.1.0",
    "@vitejs/plugin-vue": "5.2.1",
    "eslint": "9.39.5",
    "knip": "6.32.2",
    "postcss-prefixwrap": "1.58.0",
    "prettier": "3.9.6",
    "tailwindcss": "3.4.13",
    "tailwindcss-primeui": "0.6.1",
    "typescript": "5.9.3"
  }
}
